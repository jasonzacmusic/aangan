# Safe demo default (also what Vercel serves). Simulated house, no boards.
VITE_DATA_SOURCE=mock

# Live house on the school Wi-Fi, no Raspberry Pi. Build and serve from the Mac:
#   npm run lan
# Then open the printed http://192.168.0.x:8126 on any phone / iPad / laptop.
# VITE_DATA_SOURCE=live
# VITE_LIVE_BASE_URL=

# Optional later, if a Home Assistant hub is added:
# VITE_DATA_SOURCE=live
# VITE_LIVE_BASE_URL=http://homeassistant.local:8126
