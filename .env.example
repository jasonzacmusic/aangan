# Safe demo default. The app runs without a Raspberry Pi.
VITE_DATA_SOURCE=mock

# For a separately hosted live UI, use:
# VITE_DATA_SOURCE=live
# VITE_LIVE_BASE_URL=http://homeassistant.local:8126

# The Home Assistant app build uses live mode with an empty base URL so the
# PWA and bridge share one origin. Run: npm run build:addon
